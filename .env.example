# ============================================================
# AllFusion 环境变量模板（复制为 .env 后填写；.env 永不入库）
# ============================================================

# ---- 认证 ----
AF_AUTH_ENABLED=1
AF_SECRET_KEY=<Fernet key, base64>
AF_SECRET_KEY_OLD=
AF_SESSION_COOKIE=af_session
AF_SESSION_TTL_DAYS=7
AF_COOKIE_SECURE=0
AF_CAPTCHA_ENABLED=1
AF_REGISTER_ENABLED=1
# 认证服务端口（start_all.ps1 里 $AuthPort 需一致）
AF_AUTH_PORT=8004
# 写请求 Origin/Referer 白名单；留空表示只放行同源
AF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 1=严格校验 Origin（默认），0=关闭（仅本地调试用）
AF_ORIGIN_STRICT=1

# ---- MySQL（VM hadoop03）----
AF_MYSQL_DSN=mysql+pymysql://allfusion_app:***@192.168.1.136:3306/allfusion?charset=utf8mb4

# ---- 向量库后端（kb_service / memory_service 共用）----
# pg=独立 PostgreSQL + pgvector（默认）；chroma=旧 Chroma 目录（回退/对照）
AF_VECTOR_BACKEND=pg
AF_VECTOR_DSN=postgresql://postgres:postgres@127.0.0.1:5432/allfusion_vectors
AF_VECTOR_DIM=512                  # bge-small-zh-v1.5；建表后不可改

# ---- PostgreSQL（pgserver 内嵌；留空则由进程自启）----
AF_PGDATA=data/pgdata
AF_PG_DSN=
AF_PG_SETUP=1
AF_PG_POOL=8                       # PostgresSaver 连接池上限
AF_PG_START_TIMEOUT=90             # 崩溃恢复时 pg_ctl 易超 10s，这里轮询重试上限（秒）

# ---- ClickHouse ----
AF_TRACE_ENABLED=1
AF_CH_URL=http://192.168.1.136:8123
AF_CH_DB=allfusion_trace
AF_TRACE_SAMPLE=1.0
AF_TRACE_STORE_PAYLOAD=0

# ---- P1 CDC 镜像（auth_service /mirror）----
# CH 走 AF_CH_HTTP/AF_CH_URL（缺省同 AF_CH_URL 的主机）；Kafka Connect 与 broker 在 hadoop02
AF_KAFKA_CONNECT=http://192.168.1.135:8083
AF_KAFKA_BROKERS=192.168.1.135:9092
# 网关只读账号：建镜像时自动 GRANT SELECT ON af_ds_{id}.* （须由具备 ACCESS MANAGEMENT 的账号执行）
AF_CH_READER=da_readonly

# ---- 模型供应商目录 ----
AF_PROVIDER_MODELS_TTL_HOURS=24    # 模型清单自动刷新 TTL（小时）；0=关闭自动刷新，仅手动拉取

# ---- 保留策略 ----
AF_MSG_RETENTION_DAYS=180
AF_CKPT_RETENTION_DAYS=7
