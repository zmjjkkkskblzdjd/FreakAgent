# ============================================================
# DataAnalyzeAgent .gitignore（Day 1）
# 铁律：.env 与 data/、logs/ 永不入库（框架设计 §1 / §6）
# ============================================================

# ---- 密钥与环境（最高优先，绝不入库；.env.example 为模板，入库）----
.env
.env.*
!.env.example

# ---- 运行时数据：向量库 / checkpoint / 图表 / 记忆库 / 评测成绩单 ----
data/
logs/
*.log

# ---- Python 产物 ----
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.venv/
venv/

# ---- IDE / 编辑器 ----
.idea/
.vscode/

# ---- 操作系统杂物 ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
