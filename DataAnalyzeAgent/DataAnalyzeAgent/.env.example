# ============================================================
# DataAnalyzeAgent 环境变量模板（数据结构设计 §1 冻结版）
# 用法：复制本文件为 .env 并填入真实值；.env 禁止入库（.gitignore 覆盖）
# ============================================================

# ---- LLM（智谱 OpenAI 兼容端点）----
GLM_API_KEY=

# ---- D16 分档模型（不填默认全 glm-5.3-flash；切模型只改这里不改代码）----
# GLM_MODEL 是全局默认与各档回退；MODEL_CHITCHAT/LITE/DEEP/CLARIFY 逐档覆盖
#GLM_MODEL=glm-5.3-flash
#MODEL_CHITCHAT=glm-5.3-flash
#MODEL_LITE=glm-5.3-flash
#MODEL_DEEP=glm-5.3-flash
#MODEL_CLARIFY=glm-5.3-flash
# 成本估算单价（元/百万 tokens，2026-10 参考价：百炼 glm-4.7 3/14；资源包按实际口径改）
#COST_PRICE_IN_PER_M=3
#COST_PRICE_OUT_PER_M=14

# ---- 读查询网关（ClickHouse 前置，独立 FastAPI 服务，2026-10 重构）----
# 数据访问唯一入口；schema introspect 与 SQL 执行都走它，本进程不直连数据库
QUERY_GATEWAY_URL=http://127.0.0.1:8130
GATEWAY_DATABASE=sales_dw

# ---- qa_harness 术语/例题语义检索（未就绪可留空 = 语义层停用）----
QA_HARNESS_URL=

# ---- LangSmith 可观测（可选；必须在 import langchain 之前生效）----
# D16 对账：抽查时设 true + 填 key（可选 LANGSMITH_PROJECT 固定项目名）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
#LANGSMITH_PROJECT=data-analyze-agent
