# qa_harness 环境变量配置模板
# 复制为 .env 后按需修改；.env 不提交到 git

# ============================
# LLM
# ============================
GLM_API_KEY=你的智谱APIKey

# ============================
# doc_parser 微服务（纪律 §1.4）
# USE_DOC_PARSER=true → PDF/docx/pptx/xlsx/html/图片 走 doc_parser(8002) 统一转 Markdown
# USE_DOC_PARSER=false → 本地 legacy 路径（PyMuPDF / python-docx，仅本地调试）
# ============================
USE_DOC_PARSER=true
DOC_PARSER_URL=http://localhost:8002

# ============================
# 知识服务（§7/§8）：MySQL 主存只读账号 meta_ro
# ============================
KB_MYSQL_HOST=192.168.1.136
KB_MYSQL_PORT=3306
KB_MYSQL_DATABASE=sales_meta
KB_MYSQL_USER=meta_ro
KB_MYSQL_PASSWORD='<你的数据库密码>'
KB_API_HOST=0.0.0.0
KB_API_PORT=8001
