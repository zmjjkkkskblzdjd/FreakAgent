# 只读账号（/query + catalog 换绑 da_readonly）
QG_CH_HTTP=http://192.168.1.136:8123/
QG_CH_USER=da_readonly
QG_CH_PASSWORD=__填我__
# MySQL 知识库写账号（meta_rw，sales_meta 在 hadoop03）
QG_MYSQL_HOST=192.168.1.136
QG_MYSQL_PORT=3306
QG_MYSQL_DATABASE=sales_meta
QG_MYSQL_USER=meta_rw
QG_MYSQL_PASSWORD=__填我__
# MySQL 业务主库写账号（biz_rw，sales_biz 在 hadoop01；2026-10-14 CDC 架构）
QG_MYSQL_BIZ_HOST=192.168.1.134
QG_MYSQL_BIZ_PORT=3306
QG_MYSQL_BIZ_DATABASE=sales_biz
QG_MYSQL_BIZ_USER=biz_rw
QG_MYSQL_BIZ_PASSWORD=__填我__
# MySQL 管理通道（仅 setup_write_accounts.py 建账号用的运维通道，网关运行不需要；不设默认值）
QG_MYSQL_ADMIN_PASSWORD=
# ---- 平台库与内部鉴权（数据源双通道，§17.5）----
# 平台库（MySQL allfusion）：AF_MYSQL_DSN / AF_SECRET_KEY 通常已在 AllFusion/.env 配置，
# allfusion_auth.db 会自动加载；此处无需重复设置，除非网关独立部署。
# AF_MYSQL_DSN=mysql+pymysql://allfusion_app:__填我__@127.0.0.1:3306/allfusion?charset=utf8mb4
# AF_SECRET_KEY=__填我__
# ua → 网关 HMAC 签名密钥（留空 = 本机开发放行并打 WARN；生产必须配置）
AF_GATEWAY_SECRET=
AF_AUTH_SKEW_SEC=300
# 浏览器跨域白名单（留空 = 不放行任何跨域来源）
QG_ALLOWED_ORIGINS=

# ---- 直读源库限额（调用方不可放宽，§17.5.1）----
AF_DEGRADE_MAX_ROWS=200
AF_DEGRADE_TIMEOUT_MS=3000
AF_DEGRADE_MAX_CONCURRENCY=2
AF_DEGRADE_QUEUE_TIMEOUT_SEC=1
AF_BREAKER_FAILS=3
AF_BREAKER_OPEN_SEC=30
AF_BREAKER_MAX_OPEN_SEC=300
AF_FRESH_LAG_MS=5000

# ---- 两步写（一次性 preview_token，§17.5.4）----
AF_PREVIEW_TTL_SEC=60
AF_PREVIEW_RATE_PER_MIN=10
AF_WRITE_LOCK_TIMEOUT_SEC=2

# ---- 查询内存上限（对应 VM 内存大小，二选一）----
# 3G VM：QG_MAX_MEMORY_BYTES=2147483648（2 GiB，默认值，可不设）
# 2.5G VM：QG_MAX_MEMORY_BYTES=1073741824（1 GiB，须与 hadoop03 CH users.xml 的 max_memory_usage 一致）
# QG_MAX_MEMORY_BYTES=1073741824
